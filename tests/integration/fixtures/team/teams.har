n  width: 100% !important;\n  overflow: hidden !important;\n}\n.standings-box .stats-table-container {\n  max-height: none !important;\n  overflow-x: auto;\n}\n/*\n * Doubles (and other long abbreviations) make date|name|presult wider than the\n * fixed 169px .playoff-box-result. Blade/5002: result overflow visible, inner\n * flex + overflow auto + margin-bottom 30px (room for box-shadow). Do not put\n * overflow-x on result — non-visible on one axis forces the other to auto and\n * clips the inner shadow. Keep 169px result; scroll long names on inner.\n */\n.standings-box .playoff-box-result {\n  overflow: visible !important;\n  padding-bottom: 0 !important;\n}\n.standings-box .playoff-box-result .playoff-box-result-inner,\n.standings-box .playoff-box-result.matches .playoff-box-result-inner {\n  display: flex !important;\n  flex-direction: column !important;\n  box-sizing: border-box !important;\n  width: 100% !important;\n  max-width: none !important;\n  overflow-x: auto !important;\n  overflow-y: auto !important;\n  -webkit-overflow-scrolling: touch;\n  margin-bottom: 30px !important;\n}\n.standings-box .playoff-box-result .playoff-box-result-inner > li {\n  width: max-content !important;\n  min-width: 100% !important;\n  box-sizing: border-box !important;\n}\n.standings-box #playoff-header ul {\n  display: block;\n  float: none;\n  overflow: hidden;\n}\n.standings-box #playoff-header ul li {\n  font-size: 14px;\n  font-weight: 400;\n  font-family: Tahoma, Arial, sans-serif !important;\n}\n.standings-box #playoff-header {\n  padding: 4px 0 6px !important;\n  height: auto !important;\n  min-height: 20px;\n  line-height: 20px;\n  margin-bottom: 10px;\n}\n.standings-box #playoff-links {\n  display: none;\n  justify-content: space-between;\n  margin-bottom: 16px;\n  padding: 4px 6px 0;\n  line-height: 12px !important;\n}\n.standings-box #playoff-links.scrolls-x {\n  display: flex !important;\n}\n.standings-box #playoff-links a {\n  background: #06080c;\n  border: 0 none;\n  margin: 1px 0 0;\n  display: inline-block;\n  padding: 3px 6px;\n  font-weight: 700;\n  font-family: Tahoma, Arial, sans-serif !important;\n  color: #fff !important;\n  cursor: pointer;\n  text-decoration: none;\n}\n.standings-box #playoff-links a.scroll-text-inactive {\n  color: #c0c0c0 !important;\n  cursor: text;\n  text-decoration: none;\n}\n\n\n#tooltipdiv.tooltipArrow::after,\n.tooltipArrow::after {\n  display: none !important;\n  content: none !important;\n}\n#tooltipdiv .tooltip.coupon-tool-disable::after,\n.tooltipArrow .tooltip.coupon-tool-disable::after {\n  content: \"\" !important;\n  display: block !important;\n  position: absolute !important;\n  left: 0 !important;\n  right: auto !important;\n  top: 100% !important;\n  bottom: auto !important;\n  /* Pull beak 1px into the label so no white hairline */\n  margin: -1px 0 0 !important;\n  width: 10px !important;\n  height: 6px !important;\n  border: none !important;\n  transform: none !important;\n  background-color: #dee3e4 !important;\n  clip-path: polygon(0 0, 100% 0, 0 100%);\n}\n/* Column headers (Team, P, …): nudge tip toward the header row — not rank cells */\n#tooltipdiv.is-header-tip {\n  transform: translateY(8px);\n}\n/* Rank / place color cells: keep existing nudge only (do not stack with header) */\n#tooltipdiv.is-rank-tip {\n  transform: translateY(6px);\n}\n\n\n.standings-box #glib-stats-data {\n  position: relative;\n  min-height: 300px;\n}\n.standings-box #glib-stats-data.is-loading .box.selected {\n  visibility: hidden;\n}\n.standings-box .preload.standings-loading-state {\n  position: absolute;\n  inset: 0;\n  z-index: 100;\n  display: block;\n  width: 100%;\n  height: auto;\n  min-height: 300px;\n  max-height: 600px;\n  padding: 50px;\n  text-align: center;\n  opacity: 1;\n  background-color: #ffffff;\n  font-size: 15px;\n  font-weight: 700;\n  color: #4b5563;\n  border-radius: 8px;\n  pointer-events: none;\n}\n.standings-box .preload .preload-text,\n.standings-box .preload >