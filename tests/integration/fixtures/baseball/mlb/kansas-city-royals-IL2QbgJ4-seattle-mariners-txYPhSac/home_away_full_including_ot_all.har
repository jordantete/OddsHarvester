th);\n      row = pickRow(real[idx]);\n      if (row) { break; }\n      real.splice(idx, 1);\n    }\n    if (!row) { return; }\n    var container = row.parentNode;\n    var clone = row.cloneNode(true), links = clone.querySelectorAll('a[href]'), rew = 0;\n    for (var j = 0; j < links.length; j++) {\n      var h = links[j].getAttribute('href'), n = 0;\n      var v = h.replace(/-([A-Za-z0-9]{8})(?=\\/)/g, function (m) {\n        n++; return n === 1 ? '-' + T1 : (n === 2 ? '-' + T2 : m);\n      });\n      if (v !== h) { links[j].setAttribute('href', v.split('#')[0]); rew++; }\n    }\n    if (!rew) { return; }\n    clone.style.cssText = 'position:absolute;left:-9999px;top:0;height:0;overflow:hidden';\n    clone.setAttribute('aria-hidden', 'true');\n    clone.setAttribute('data-ab-trap', '1');\n    var rowsList = [];\n    for (var p = 0; p < container.children.length; p++) {\n      if (hasMatch(container.children[p])) { rowsList.push(container.children[p]); }\n    }\n    var anchor = rowsList.length > 1\n      ? rowsList[Math.floor(Math.random() * rowsList.length)]\n      : row;\n    container.insertBefore(clone, anchor.nextSibling);\n  }\n  function pruneStale() {\n    var el = findExisting();\n    if (el && !el.isConnected) { return; }\n    if (el && el.parentNode && !hasMatch(el.parentNode)) { el.parentNode.removeChild(el); }\n  }\n  function tick() { pruneStale(); inject(); }\n  var DEBOUNCE_MS = 400, LIVENESS_WINDOW_MS = 8000;\n  var debounceHandle = null, sawRealMutation = false;\n  function debouncedTick() {\n    if (debounceHandle) { clearTimeout(debounceHandle); }\n    debounceHandle = setTimeout(tick, DEBOUNCE_MS);\n  }\n  var observer;\n  try {\n    observer = new MutationObserver(function () { sawRealMutation = true; debouncedTick(); });\n    observer.observe(document.body, { childList: true, subtree: true });\n  } catch (e) { observer = null; }\n  setTimeout(function () {\n    if (sawRealMutation) { return; }\n    function armFallback() {\n      tick();\n      setTimeout(armFallback, 20000 + Math.floor(Math.random() * 20000));\n    }\n    armFallback();\n  }, LIVENESS_WINDOW_MS);\n  tick();\n})('ab0cf146', 'b75bd852');</script></div><!--/&--><script>requestAnimationFrame(function(){$RT=performance.now()});</script><script src=\"/_next/static/chunks/431bw722fec3m.js\" id=\"_R_\" async=\"\"></script><div hidden id=\"S:51\"><footer class=\"flex w-full flex-col gap-4 bg-black-main font-main text-xs text-white-main max-md:text-sm\"><div class=\"footer px-[24px] pb-[24px] pt-[36px] text-sm\"><div class=\"mb-10 flex flex-wrap\"><div class=\"flex-1 max-mm:pr-4\"><p class=\"mb-4 font-bold uppercase\"><!--$?--><template id=\"B:c\"></template><a href=\"/football/\">football</a><!--/$--></p><ul><li class=\"mb-3\"><!--$?--><template id=\"B:d\"></template><a href=\"/football/england/premier-league/\">Premier League</a><!--/$--></li><li class=\"mb-3\"><!--$?--><template id=\"B:e\"></template><a href=\"/football/spain/laliga/\">LaLiga EA Sports</a><!--/$--></li><li class=\"mb-3\"><!--$?--><template id=\"B:f\"></template><a href=\"/football/italy/serie-a/\">Serie A</a><!--/$--></li><li class=\"mb-3\"><!--$?--><template id=\"B:10\"></template><a href=\"/football/germany/bundesliga/\">Bundesliga</a><!--/$--></li><li class=\"mb-3\"><!--$?--><template id=\"B:11\"></template><a href=\"/football/france/ligue-1/\">Ligue 1</a><!--/$--></li><li class=\"mb-3\"><!--$?--><template id=\"B:12\"></template><a href=\"/football/europe/champions-league/\">Champions League</a><!--/$--></li><li class=\"mb-3\"><!--$?--><template id=\"B:13\"></template><a href=\"/football/europe/europa-league/\">Europa League</a><!--/$--></li><li class=\"mb-3\"><!--$?--><template id=\"B:14\"></template><a href=\"/football/europe/conference-league/\">Europa Conference League</a><!--/$--></li></ul></div><div class=\"flex-1\"><p class=\"mb-4 font-bold uppercase\"><!--$?--><template id=\"B:15\"></template><a href=\"/tennis/\">tennis</a><!--/$--></p><ul><li class=\"mb-3\"><!--$?