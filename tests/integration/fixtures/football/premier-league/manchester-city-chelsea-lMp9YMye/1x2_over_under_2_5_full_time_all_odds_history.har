redictions\\\",\\\"probability\\\":\\\"Probability\\\",\\\"probability_short\\\":\\\"Prob.\\\",\\\"all_bookies_label\\\":\\\"All Bookies\\\",\\\"classic_bookies_label\\\":\\\"Classic Bookies\\\",\\\"crypto_bookies_label\\\":\\\"Crypto Bookies\\\",\\\"btts_tooltip_text\\\":\\\"Percentage of matches where both teams scored (counting the last 6 games).\\\",\\\"over_2_5_tooltip_text\\\":\\\"Percentage of matches with over [goals] total goals from the last 6 games.\\\",\\\"new_username\\\":\\\"New Username\\\",\\\"bookie_offer_no_odds\\\":\\\"This bookmaker doesn’t offer odds for this match.\\\",\\\"hide_bookies_without_odds\\\":\\\"Hide bookmakers without odds\\\",\\\"es_age_modal_title\\\":\\\"Disfruta al máximo de CuotasAhora.com\\\",\\\"es_age_modal_text\\\":\\\"Para sacar el máximo partido de nuestro contenido, incluidas las cuotas, por favor, confirma tu edad.\\\",\\\"es_age_modal_primary_btn\\\":\\\"Soy mayor de 18 años\\\",\\\"es_age_modal_secondary_btn\\\":\\\"Soy menor de 18 años\\\",\\\"average_points_scored\\\":\\\"Av. Points Scored\\\",\\\"average_points_conceded\\\":\\\"Av. Points Conceded\\\",\\\"average_runs_scored\\\":\\\"Av. Runs Scored\\\",\\\"average_runs_conceded\\\":\\\"Av. Runs Conceded\\\",\\\"over_points_tooltip_text\\\":\\\"Percentage of games with over [points] total points of the last 6 games\\\",\\\"over_runs_tooltip_text\\\":\\\"Percentage of matches with over [runs] total runs from the last 6 games.\\\",\\\"shutout_games\\\":\\\"Shutout Games\\\",\\\"shutout_games_tooltip_text\\\":\\\"Games with 0 runs conceded by the team\\\",\\\"strip_baner_title\\\":\\\"Best odds on your favorite team\\\",\\\"strip_baner_text\\\":\\\"{provider} is offering the highest total odds (\\u003cstrong\\u003e{odds}\\u003c/strong\\u003e) for {team} to win their {gamesnumber} upcoming matches, with a strong \\u003cstrong\\u003e{payout}%\\u003c/strong\\u003e payout.\\\",\\\"strip_baner_cta\\\":\\\"BET NOW\\\",\\\"strip_baner_info_text\\\":\\\"Instead of comparing bo